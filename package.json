{
  "name": "repo-rate-visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-atlas.ts && node scripts/build-api.ts && vite build && node scripts/prerender.ts && node scripts/check-bundle.ts",
    "dev": "vite",
    "preview": "vite preview",
    "test:app": "node --test \"tests/app/**/*.test.ts\"",
    "test:browser": "playwright test",
    "test:data": "node --test tests/data/snapshotV2.test.js tests/data/rbiSources.test.js tests/data/supplementalHistory.test.js tests/data/releaseManifest.test.js",
    "test:hf-dataset": "python3 -m unittest tests/data/test_hf_datasets.py",
    "test:pipeline": "node --test \"tests/pipeline/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json",
    "validate:data": "node pipeline/publish.ts --check",
    "analytics:report": "node scripts/analytics-report.ts",
    "build:hf": "node scripts/build-hf-tables.ts && python3 scripts/build-hf-datasets.py"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "lucide": "1.52.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261007.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "linkedom": "0.18.13",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "wrangler": "4.151.3"
  }
}
